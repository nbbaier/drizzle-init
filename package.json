{
  "name": "drizzle-init",
  "version": "0.0.14",
  "description": "minimalist starter template to get started with drizzle-orm",
  "main": "dist/index.mjs",
  "repository": {
    "url": "https://github.com/Naeem-gg/drizzle-init.git"
  },
  "scripts": {
    "lint": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:update": "bun test --update-snapshots",
    "build": "tsdown"
  },
  "bin": {
    "drizzle-init": "./dist/index.mjs"
  },
  "type": "module",
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "drizzle-kit",
    "postgresql",
    "mysql",
    "sqlite"
  ],
  "author": "naeemgg",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "figlet": "^1.7.0",
    "@inquirer/core": "^10.1.0",
    "@inquirer/prompts": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@types/bun": "^1.3.7",
    "@types/figlet": "^1.7.0",
    "@types/node": "^25.1.0",
    "@typescript/native-preview": "^7.0.0-dev.20260128.1",
    "tsdown": "^0.20.1",
    "typescript": "^5.7.0",
    "ultracite": "7.1.1"
  }
}
