{
  "name": "drizzle-init",
  "version": "0.0.14",
  "description": "minimalist starter template to get started with drizzle-orm",
  "main": "dist/index.mjs",
  "repository": {
    "url": "https://github.com/Naeem-gg/drizzle-init.git"
  },
  "scripts": {
    "lint": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:update": "bun test --update-snapshots",
    "build": "tsdown"
  },
  "bin": {
    "drizzle-init": "./dist/index.mjs"
  },
  "type": "module",
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "drizzle-kit",
    "postgresql",
    "mysql",
    "sqlite"
  ],
  "author": "naeemgg",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "figlet": "^1.11.0",
    "@inquirer/core": "^11.1.7",
    "@inquirer/prompts": "^8.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@types/bun": "^1.3.11",
    "@types/figlet": "^1.7.0",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "^7.0.0-dev.20260328.1",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "ultracite": "7.3.2"
  }
}
